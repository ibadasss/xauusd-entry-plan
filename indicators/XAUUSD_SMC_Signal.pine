//@version=6
// ============================================================================
//  XAUUSD SMC SIGNAL BOT  v2.3  (Smart Money Concepts)  -  Pine Script v6
//  Tipe : INDICATOR (Signal only / NO auto-entry)
//
//  PENYARING KETAT (v2.3) untuk menaikkan winrate di XAU/USD:
//   1. STRICT TF ALIGNMENT : BUY hanya jika HTF & LTF SAMA-SAMA bullish,
//                            SELL hanya jika keduanya bearish. Counter-trend dicoret.
//   2. LIQUIDITY SWEEP      : CHoCH baru dianggap valid jika DIDAHULUI sweep
//                            (ekor menembus swing lalu close balik ke dalam range).
//   3. SESSION FILTER       : alert hanya 13:00-22:00 WIB (London + New York).
//   4. RISK 30-60 PIPS      : SL min 30 pips, max 60 pips. Jika OB terlalu lebar,
//                            entry digeser ke 50% OB (equilibrium). Masih >60 -> coret.
//
//  Catatan v6: pesan multi-baris pakai "\n" dalam SATU baris fisik; guard na ada.
// ============================================================================
indicator("XAUUSD SMC Signal Bot [v2.3]", shorttitle="XAU SMC v2.3", overlay=true,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================== INPUTS ====================================
grpMS   = "1. Market Structure"
swingLen = input.int(10, "Swing Length (Pivot L/R)", minval=2, maxval=50, group=grpMS,
     tooltip="Bar kiri & kanan untuk validasi Swing High/Low. M3/M5: 5-8, M15/H1: 10-15.")
showMS   = input.bool(true, "Tampilkan Label BOS / CHoCH", group=grpMS)

grpOB   = "2. Order Block (OB)"
showOB        = input.bool(true,  "Tampilkan Order Block", group=grpOB)
obRequireFVG  = input.bool(true,  "OB wajib punya Imbalance/FVG di depannya", group=grpOB)
obMax         = input.int(6, "Maksimal OB ditampilkan", minval=1, maxval=20, group=grpOB)
bullOBColor   = input.color(color.new(color.green, 78), "Bullish OB (Demand)", group=grpOB)
bearOBColor   = input.color(color.new(color.red,   78), "Bearish OB (Supply)", group=grpOB)

grpFVG  = "3. Fair Value Gap (FVG)"
showFVG     = input.bool(true, "Tampilkan FVG / Imbalance", group=grpFVG)
fvgMax      = input.int(10, "Maksimal FVG ditampilkan", minval=1, maxval=30, group=grpFVG)
bullFVGColor= input.color(color.new(color.teal,   80), "Bullish FVG", group=grpFVG)
bearFVGColor= input.color(color.new(color.orange, 80), "Bearish FVG", group=grpFVG)

grpSig  = "4. Signal Engine"
useOB   = input.bool(true, "Sinyal dari mitigasi OB",  group=grpSig)
useFVG  = input.bool(true, "Sinyal dari mitigasi FVG", group=grpSig)
oncePerBarClose = input.bool(true, "Sinyal hanya pada bar close (anti-repaint)", group=grpSig)

grpHTF  = "5. HTF Bias & Strict Alignment"
useHTF        = input.bool(true,  "Aktifkan filter Higher Timeframe", group=grpHTF)
useStrictAlign= input.bool(true,  "STRICT: HTF & LTF wajib searah", group=grpHTF,
     tooltip="BUY hanya jika HTF bullish DAN LTF (struktur) bullish. SELL kebalikannya. Counter-trend dicoret.")
htfTf         = input.timeframe("60", "Higher Timeframe", group=grpHTF,
     tooltip="Contoh: chart M5 -> pakai 60 (H1). Chart M15 -> pakai 240 (H4).")
htfEmaLen     = input.int(50, "Panjang EMA Bias HTF", minval=5, group=grpHTF)

grpSweep = "6. Liquidity Sweep (Anti-Inducement)"
useSweep      = input.bool(true, "CHoCH wajib didahului Liquidity Sweep", group=grpSweep,
     tooltip="CHoCH bullish valid jika ada sweep sisi sell (low menembus swing low lalu close balik di atasnya). Bearish kebalikannya.")
sweepLookback = input.int(12, "Max jarak sweep -> CHoCH (bar)", minval=1, maxval=60, group=grpSweep)

grpLiq  = "7. Liquidity (Equal Highs / Lows)"
showLiq   = input.bool(true, "Tampilkan EQH / EQL", group=grpLiq)
eqAtrFac  = input.float(0.10, "Toleransi EqH/EqL (x ATR)", minval=0.01, step=0.01, group=grpLiq)

grpTP   = "8. Auto SL / TP"
showLevels = input.bool(true,  "Tampilkan label Entry/SL/TP", group=grpTP)
rr         = input.float(2.0,  "Risk : Reward (TP)", minval=0.5, step=0.5, group=grpTP)
slBuffer   = input.float(1.0,  "Buffer SL (harga, $ untuk Gold)", minval=0.0, step=0.1, group=grpTP)

grpRisk = "9. Risk Management (Pips 30-60)"
pipValue  = input.float(0.10, "Nilai 1 Pip (harga)", minval=0.001, step=0.01, group=grpRisk,
     tooltip="XAU/USD: 1 pip = 0.10 harga (10 pips = $1.00). Sesuaikan dengan konvensi broker Anda.")
minPips   = input.float(30.0, "SL Minimal (pips)", minval=1.0, step=1.0, group=grpRisk,
     tooltip="Jika SL teknikal < nilai ini, SL dibulatkan naik agar aman dari noise/spread.")
maxPips   = input.float(60.0, "SL Maksimal (pips)", minval=1.0, step=1.0, group=grpRisk,
     tooltip="Jika SL teknikal > nilai ini: terapkan mode di bawah.")
maxMode   = input.string("Geser Entry ke 50% (Opsi B)", "Aksi saat SL > Maksimal", group=grpRisk,
     options=["Geser Entry ke 50% (Opsi B)", "Abaikan Sinyal (Opsi A)"])

grpQual = "10. Signal Quality (Anti Over-Trading)"
maxZoneAge   = input.int(50, "Max umur zona untuk sinyal (bar)", minval=1, group=grpQual)
cooldownBars = input.int(10, "Cooldown antar sinyal (bar)", minval=0, group=grpQual)
useOneTrade  = input.bool(true, "Satu posisi aktif dalam satu waktu", group=grpQual)

grpStat = "11. Win-rate Counter"
showStats   = input.bool(true, "Tampilkan statistik Win/Loss", group=grpStat)
useIntrabar = input.bool(true, "Resolusi akurat via data intrabar", group=grpStat)
lowerTf     = input.timeframe("1", "Intrabar Timeframe", group=grpStat)

grpSess = "12. Session Filter (WIB)"
useSession = input.bool(true, "Hanya sinyal saat sesi aktif", group=grpSess)
sessStr    = input.session("1300-2200", "Jendela sesi aktif (London + NY)", group=grpSess,
     tooltip="Default 13:00-22:00 WIB. Ubah jika ingin sesi lain.")
sessTz     = input.string("Asia/Jakarta", "Timezone sesi", group=grpSess,
     options=["Asia/Jakarta", "Europe/London", "America/New_York", "Asia/Tokyo", "UTC"])

// ========================= USER-DEFINED TYPES ==============================
type Zone
    box   bx
    float top
    float bot
    bool  bull
    bool  mitigated
    int   created

type Trade
    bool  isBuy
    float sl
    float tp

var array<Zone>  obList  = array.new<Zone>()
var array<Zone>  fvgList = array.new<Zone>()
var array<Trade> trades  = array.new<Trade>()
var int wins   = 0
var int losses = 0
var int lastSigBar = na
var int firstSigTime = na

// =================== DATA INTRABAR (untuk resolusi Win/Loss) ===============
aLow  = request.security_lower_tf(syminfo.tickerid, lowerTf, low)
aHigh = request.security_lower_tf(syminfo.tickerid, lowerTf, high)

// =================== 1. MARKET STRUCTURE (BOS & CHoCH) =====================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float swingHigh = na
var float swingLow  = na
var int   trend     = 0
var bool  brokeHigh = false
var bool  brokeLow  = false

if not na(ph)
    swingHigh := ph
    brokeHigh := false
if not na(pl)
    swingLow := pl
    brokeLow := false

bool bosBull   = false
bool bosBear   = false
bool chochBull = false
bool chochBear = false

if not na(swingHigh) and close > swingHigh and not brokeHigh
    if trend == -1
        chochBull := true
    else
        bosBull := true
    trend     := 1
    brokeHigh := true

if not na(swingLow) and close < swingLow and not brokeLow
    if trend == 1
        chochBear := true
    else
        bosBear := true
    trend     := -1
    brokeLow  := true

// =================== 2. LIQUIDITY SWEEP DETECTION ==========================
// Sweep sell-side : low menembus swing low lalu close balik DI ATAS swing low.
// Sweep buy-side  : high menembus swing high lalu close balik DI BAWAH swing high.
var int sweepLowBar  = na
var int sweepHighBar = na

if not na(swingLow) and low < swingLow and close > swingLow
    sweepLowBar := bar_index
if not na(swingHigh) and high > swingHigh and close < swingHigh
    sweepHighBar := bar_index

bool sweepRecentLow  = not na(sweepLowBar)  and (bar_index - sweepLowBar)  <= sweepLookback
bool sweepRecentHigh = not na(sweepHighBar) and (bar_index - sweepHighBar) <= sweepLookback

// CHoCH valid hanya bila didahului sweep yang sesuai
bool chochBullV = chochBull and (not useSweep or sweepRecentLow)
bool chochBearV = chochBear and (not useSweep or sweepRecentHigh)

// --- Label Struktur (CHoCH hanya bila valid) ---
if showMS
    if bosBull
        label.new(bar_index, low,  "BOS ▲",   style=label.style_label_up,   color=color.new(color.green,  0), textcolor=color.white, size=size.small)
    if chochBullV
        label.new(bar_index, low,  "CHoCH ▲", style=label.style_label_up,   color=color.new(color.lime,   0), textcolor=color.black, size=size.small)
    if bosBear
        label.new(bar_index, high, "BOS ▼",   style=label.style_label_down, color=color.new(color.red,    0), textcolor=color.white, size=size.small)
    if chochBearV
        label.new(bar_index, high, "CHoCH ▼", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.black, size=size.small)

// =================== 7. LIQUIDITY : EQUAL HIGHS / LOWS =====================
atr = ta.atr(14)
eqThresh = atr * eqAtrFac

var float lastPH    = na
var int   lastPHbar = na
var float lastPL    = na
var int   lastPLbar = na

if not na(ph)
    int curBar = bar_index - swingLen
    if showLiq and not na(lastPH) and math.abs(ph - lastPH) <= nz(eqThresh)
        line.new(lastPHbar, lastPH, curBar, ph, color=color.new(color.yellow, 0), style=line.style_dotted, width=1)
        label.new(curBar, ph, "EQH 💧", style=label.style_label_down, color=color.new(color.yellow, 70), textcolor=color.yellow, size=size.tiny)
    lastPH    := ph
    lastPHbar := curBar

if not na(pl)
    int curBarL = bar_index - swingLen
    if showLiq and not na(lastPL) and math.abs(pl - lastPL) <= nz(eqThresh)
        line.new(lastPLbar, lastPL, curBarL, pl, color=color.new(color.fuchsia, 0), style=line.style_dotted, width=1)
        label.new(curBarL, pl, "EQL 💧", style=label.style_label_up, color=color.new(color.fuchsia, 70), textcolor=color.fuchsia, size=size.tiny)
    lastPL    := pl
    lastPLbar := curBarL

// ===================== 5. HTF BIAS FILTER ==================================
htfClose = request.security(syminfo.tickerid, htfTf, close,                    lookahead=barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
htfBull  = not na(htfClose) and not na(htfEma) and htfClose > htfEma
htfBear  = not na(htfClose) and not na(htfEma) and htfClose < htfEma

// LTF bias dari struktur
bool ltfBull = trend == 1
bool ltfBear = trend == -1

// ===================== 12. SESSION FILTER ==================================
inSession = not useSession or not na(time(timeframe.period, sessStr, sessTz))

// =================== HELPER: OB index & cek imbalance ======================
f_bullOBIndex() =>
    int idx = na
    for i = 1 to 30
        if na(idx) and close[i] < open[i]
            idx := i
    idx

f_bearOBIndex() =>
    int idx = na
    for i = 1 to 30
        if na(idx) and close[i] > open[i]
            idx := i
    idx

f_hasBullImb(n) =>
    bool found = false
    for j = 0 to n
        if low[j] > high[j + 2]
            found := true
    found

f_hasBearImb(n) =>
    bool found = false
    for j = 0 to n
        if high[j] < low[j + 2]
            found := true
    found

// Resolusi 1 trade: 1 = TP (Win), -1 = SL (Loss), 0 = belum selesai.
f_resolve(bool isBuy, float slv, float tpv) =>
    int res = 0
    if useIntrabar and array.size(aLow) > 0
        for m = 0 to array.size(aLow) - 1
            if res == 0
                float lo = array.get(aLow, m)
                float hi = array.get(aHigh, m)
                if isBuy
                    res := lo <= slv ? -1 : hi >= tpv ? 1 : 0
                else
                    res := hi >= slv ? -1 : lo <= tpv ? 1 : 0
    else
        bool hitSL = isBuy ? low <= slv : high >= slv
        bool hitTP = isBuy ? high >= tpv : low <= tpv
        if hitSL and hitTP
            res := math.abs(open - slv) <= math.abs(open - tpv) ? -1 : 1
        else if hitSL
            res := -1
        else if hitTP
            res := 1
    res

// =================== MODUL RISK 30-60 PIPS (Opsi B) ========================
// Kembali: [ok, entry, sl, tp, slPips]
f_risk(bool isBuy, float px, float zTop, float zBot) =>
    float pv = pipValue <= 0 ? 0.1 : pipValue
    float e  = px
    float s  = isBuy ? zBot - slBuffer : zTop + slBuffer
    float dist = math.abs(e - s)
    float pips = dist / pv
    bool  ok = true
    // --- MAKSIMAL SL ---
    if pips > maxPips
        if maxMode == "Abaikan Sinyal (Opsi A)"
            ok := false
        else
            // Opsi B: geser entry ke 50% OB (equilibrium)
            e    := (zTop + zBot) / 2.0
            s    := isBuy ? zBot - slBuffer : zTop + slBuffer
            dist := math.abs(e - s)
            pips := dist / pv
            if pips > maxPips
                ok := false
    // --- MINIMAL SL ---
    if ok and pips < minPips
        dist := minPips * pv
        s    := isBuy ? e - dist : e + dist
        pips := minPips
    float t = ok ? (isBuy ? e + rr * dist : e - rr * dist) : na
    [ok, e, s, t, pips]

// ============== SIGNAL FLAGS + penampung zona untuk SL/TP ==================
bool  buyRaw     = false
bool  sellRaw    = false
float sigZoneTop = na
float sigZoneBot = na

// ============= 2A. UPDATE & MITIGASI ORDER BLOCK ===========================
if array.size(obList) > 0
    for i = 0 to array.size(obList) - 1
        Zone z = array.get(obList, i)
        if not z.mitigated
            box.set_right(z.bx, bar_index)
            bool touch = low <= z.top and high >= z.bot
            if touch
                z.mitigated := true
                box.set_bgcolor(z.bx, color.new(color.gray, 85))
                box.set_border_color(z.bx, color.new(color.gray, 60))
                bool fresh = (bar_index - z.created) <= maxZoneAge
                if z.bull and trend == 1 and useOB and fresh
                    buyRaw     := true
                    sigZoneTop := z.top
                    sigZoneBot := z.bot
                if (not z.bull) and trend == -1 and useOB and fresh
                    sellRaw    := true
                    sigZoneTop := z.top
                    sigZoneBot := z.bot

// ============= 2B. UPDATE & MITIGASI FVG ===================================
if array.size(fvgList) > 0
    for i = 0 to array.size(fvgList) - 1
        Zone z = array.get(fvgList, i)
        if not z.mitigated
            box.set_right(z.bx, bar_index)
            bool fill = low <= z.top and high >= z.bot
            if fill
                z.mitigated := true
                box.set_bgcolor(z.bx, color.new(color.gray, 90))
                bool fresh = (bar_index - z.created) <= maxZoneAge
                if z.bull and trend == 1 and useFVG and fresh
                    buyRaw     := true
                    sigZoneTop := z.top
                    sigZoneBot := z.bot
                if (not z.bull) and trend == -1 and useFVG and fresh
                    sellRaw    := true
                    sigZoneTop := z.top
                    sigZoneBot := z.bot

// ============= 3. BUAT ORDER BLOCK BARU saat break (CHoCH wajib valid) =====
if showOB and (bosBull or chochBullV)
    int obi = f_bullOBIndex()
    if not na(obi)
        bool okImb = (not obRequireFVG) or f_hasBullImb(obi)
        if okImb
            box bx = box.new(bar_index[obi], high[obi], bar_index, low[obi],
                 border_color=color.new(color.green, 40), bgcolor=bullOBColor)
            array.push(obList, Zone.new(bx, high[obi], low[obi], true, false, bar_index))

if showOB and (bosBear or chochBearV)
    int obi2 = f_bearOBIndex()
    if not na(obi2)
        bool okImb2 = (not obRequireFVG) or f_hasBearImb(obi2)
        if okImb2
            box bx2 = box.new(bar_index[obi2], high[obi2], bar_index, low[obi2],
                 border_color=color.new(color.red, 40), bgcolor=bearOBColor)
            array.push(obList, Zone.new(bx2, high[obi2], low[obi2], false, false, bar_index))

while array.size(obList) > obMax
    Zone old = array.shift(obList)
    box.delete(old.bx)

// ============= 4. DETEKSI FVG BARU (pola 3-candle) =========================
if showFVG and low > high[2]
    box fb = box.new(bar_index[1], low, bar_index, high[2], border_color=na, bgcolor=bullFVGColor)
    array.push(fvgList, Zone.new(fb, low, high[2], true, false, bar_index))

if showFVG and high < low[2]
    box fb2 = box.new(bar_index[1], low[2], bar_index, high, border_color=na, bgcolor=bearFVGColor)
    array.push(fvgList, Zone.new(fb2, low[2], high, false, false, bar_index))

while array.size(fvgList) > fvgMax
    Zone oldf = array.shift(fvgList)
    box.delete(oldf.bx)

// =================== RESOLUSI TRADE TERBUKA (sebelum sinyal baru) ==========
if array.size(trades) > 0
    int k = 0
    while k < array.size(trades)
        Trade t = array.get(trades, k)
        int r = f_resolve(t.isBuy, t.sl, t.tp)
        if r == 1
            wins := wins + 1
            array.remove(trades, k)
        else if r == -1
            losses := losses + 1
            array.remove(trades, k)
        else
            k := k + 1

// ===================== GATING : STRICT ALIGN + sesi + cooldown + 1-posisi ==
bool cooled    = na(lastSigBar) or (bar_index - lastSigBar) >= cooldownBars
bool slotFree  = (not useOneTrade) or array.size(trades) == 0
bool canSignal = inSession and cooled and slotFree

// STRICT TF ALIGNMENT: HTF & LTF wajib searah (coret counter-trend)
bool buyAlign  = useStrictAlign ? (htfBull and ltfBull) : (not useHTF or htfBull)
bool sellAlign = useStrictAlign ? (htfBear and ltfBear) : (not useHTF or htfBear)

bool buyPre  = buyRaw  and buyAlign  and canSignal
bool sellPre = sellRaw and sellAlign and canSignal

// ========================= RISK MODULE -> SL/TP ============================
fmt = "#.##"
float entry  = na
float sl     = na
float tp     = na
float slPips = na
bool  riskOk = false

if buyPre and not na(sigZoneTop) and not na(sigZoneBot)
    [okk, ee, ss, tt, pp] = f_risk(true, close, sigZoneTop, sigZoneBot)
    riskOk := okk
    entry  := ee
    sl     := ss
    tp     := tt
    slPips := pp

if sellPre and not na(sigZoneTop) and not na(sigZoneBot)
    [okk, ee, ss, tt, pp] = f_risk(false, close, sigZoneTop, sigZoneBot)
    riskOk := okk
    entry  := ee
    sl     := ss
    tp     := tt
    slPips := pp

// SINYAL FINAL: lolos arah + sesi + cooldown + slot + risk valid
bool buySignal  = buyPre  and riskOk
bool sellSignal = sellPre and riskOk

if showLevels and (buySignal or sellSignal)
    string lvTxt = (buySignal ? "BUY" : "SELL") + "\nEntry: " + str.tostring(entry, fmt) + "\nSL: " + str.tostring(sl, fmt) + " (" + str.tostring(slPips, "#.#") + "p)" + "\nTP: " + str.tostring(tp, fmt)
    label.new(bar_index, buySignal ? low : high, lvTxt, style = buySignal ? label.style_label_up : label.style_label_down, color = buySignal ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)

// =================== CATAT TRADE BARU + update cooldown ====================
if buySignal
    array.push(trades, Trade.new(true,  sl, tp))
    lastSigBar := bar_index
    if na(firstSigTime)
        firstSigTime := time
if sellSignal
    array.push(trades, Trade.new(false, sl, tp))
    lastSigBar := bar_index
    if na(firstSigTime)
        firstSigTime := time

// =================== VISUAL SINYAL + PANEL ================================
plotshape(buySignal,  title="BUY Signal",  style=shape.triangleup,
     location=location.belowbar, color=color.new(color.lime, 0), size=size.small)
plotshape(sellSignal, title="SELL Signal", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 0),  size=size.small)

var table info = table.new(position.top_right, 2, 7, border_width=1, frame_color=color.gray, frame_width=1)
if barstate.islast
    string tTxt = trend == 1 ? "BULLISH ▲" : trend == -1 ? "BEARISH ▼" : "RANGING"
    color  tCol = trend == 1 ? color.green : trend == -1 ? color.red : color.gray
    table.cell(info, 0, 0, "LTF",  text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 1, 0, tTxt,   text_color=color.white, bgcolor=tCol, text_size=size.small)
    string hTxt = htfBull ? "BULL ▲" : htfBear ? "BEAR ▼" : "-"
    color  hCol = htfBull ? color.teal : htfBear ? color.maroon : color.gray
    table.cell(info, 0, 1, "HTF",  text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 1, 1, hTxt,   text_color=color.white, bgcolor=hCol, text_size=size.small)
    bool aligned = (htfBull and ltfBull) or (htfBear and ltfBear)
    table.cell(info, 0, 2, "Align/Sesi", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 1, 2, (aligned ? "OK" : "NO") + " / " + (inSession ? "BUKA" : "TUTUP"), text_color=color.white, bgcolor=(aligned and inSession) ? color.green : color.gray, text_size=size.small)
    int   total = wins + losses
    float wRate = total > 0 ? 100.0 * wins / total : 0.0
    color wCol  = total == 0 ? color.gray : wRate >= 50 ? color.green : color.red
    table.cell(info, 0, 3, "Trade", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 1, 3, str.tostring(total) + " (" + str.tostring(wins) + "W/" + str.tostring(losses) + "L)", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 0, 4, "Win%",  text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 1, 4, str.tostring(wRate, "#.#") + "%", text_color=color.white, bgcolor=wCol, text_size=size.small)
    string startTxt = na(firstSigTime) ? "-" : str.format_time(firstSigTime, "yyyy-MM-dd HH:mm", sessTz)
    string endTxt   = str.format_time(time, "yyyy-MM-dd HH:mm", sessTz)
    table.cell(info, 0, 5, "Mulai", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 1, 5, startTxt, text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)
    table.cell(info, 0, 6, "Akhir", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(info, 1, 6, endTxt, text_color=color.white, bgcolor=color.new(color.black, 40), text_size=size.small)

// =================== ALERTS (Webhook Telegram) ============================
alertcondition(buySignal,  title="XAUUSD SMC - BUY",  message="[⚠️ XAUUSD SMC SIGNAL]\nType: BUY\nPrice: {{close}}\nTimeframe: {{interval}}\nNote: Strict align + sweep + sesi WIB lolos. Mitigasi OB/FVG. Konfirmasi manual.")
alertcondition(sellSignal, title="XAUUSD SMC - SELL", message="[⚠️ XAUUSD SMC SIGNAL]\nType: SELL\nPrice: {{close}}\nTimeframe: {{interval}}\nNote: Strict align + sweep + sesi WIB lolos. Mitigasi OB/FVG. Konfirmasi manual.")

alertFreq = oncePerBarClose ? alert.freq_once_per_bar_close : alert.freq_once_per_bar

if buySignal
    alert("[⚠️ XAUUSD SMC SIGNAL]\nType: BUY\nPrice: " + str.tostring(close, fmt) + "\nTimeframe: " + timeframe.period + "\nEntry: " + str.tostring(entry, fmt) + "\nSL: " + str.tostring(sl, fmt) + " (" + str.tostring(slPips, "#.#") + " pips)\nTP: " + str.tostring(tp, fmt) + "  (RR 1:" + str.tostring(rr) + ")\nNote: HTF+LTF bullish, sweep ok, sesi WIB aktif. Konfirmasi manual sebelum entry.", alertFreq)

if sellSignal
    alert("[⚠️ XAUUSD SMC SIGNAL]\nType: SELL\nPrice: " + str.tostring(close, fmt) + "\nTimeframe: " + timeframe.period + "\nEntry: " + str.tostring(entry, fmt) + "\nSL: " + str.tostring(sl, fmt) + " (" + str.tostring(slPips, "#.#") + " pips)\nTP: " + str.tostring(tp, fmt) + "  (RR 1:" + str.tostring(rr) + ")\nNote: HTF+LTF bearish, sweep ok, sesi WIB aktif. Konfirmasi manual sebelum entry.", alertFreq)
